APP_ENV=development
ENABLE_LIVE_TRADING=false
ALLOW_BILLABLE_TESTS=false
REQUIRED_PROVIDERS=HYPERLIQUID_PUBLIC,COINBASE_PUBLIC

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17

ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_MODE=paper
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
# Separate retrospective research feed; requires historical SIP entitlement.
ALPACA_RESEARCH_FEED=sip
ALPACA_PAPER_EXECUTION_ENABLED=false

SEC_USER_AGENT=
FRED_API_KEY=
EIA_API_KEY=



COINBASE_API_KEY_NAME=
COINBASE_PRIVATE_KEY_PATH=./secrets/coinbase_private.pem
COINBASE_TRADING_ENABLED=false

HYPERLIQUID_NETWORK=mainnet
HYPERLIQUID_TRADING_ENABLED=false

# Optional AI. Existing .env stays untouched; absent values use these defaults.
LLM_PROVIDER=off
LLM_AUTOMATED_ANALYSIS_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
OPENAI_AUTOMATED_ANALYSIS_ENABLED=false
OPENAI_DAILY_BUDGET_USD=1.00
OPENAI_MONTHLY_BUDGET_USD=15.00
OPENAI_MAX_CALLS_PER_HOUR=10
OPENAI_ESCALATION_ENABLED=false
OPENAI_ESCALATION_MODEL_ENABLED=false
OPENAI_ESCALATION_MODEL=
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
MARKET_POLL_SECONDS=60
MARKET_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
ENABLE_MARKET_POLLING=true
COINBASE_STREAM_ENABLED=true
COINBASE_STREAM_BOOKS=false
COINBASE_STREAM_TRADES=false

# Continuous read-only Alpaca news. Uses existing account access; no LLM calls.
ALPACA_NEWS_ENABLED=true
